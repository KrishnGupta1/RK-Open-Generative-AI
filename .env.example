# ── RK GEM AI ─────────────────────────────────────────────────────────
# All keys below are OPTIONAL. If you set one, every visitor gets a
# working chat out of the box (server-side fallback key). If you leave
# them empty, each user brings their own key from Settings → Providers.

# OpenRouter — free ":free" models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq — very fast free tier. https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (AI Studio). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Local Ollama (defaults to http://127.0.0.1:11434/v1).
# In Docker use http://host.docker.internal:11434/v1
# On a VPS run `OLLAMA_HOST=0.0.0.0 ollama serve` and put the public URL here.
OLLAMA_BASE_URL=

# Extra free tiers (optional)
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Accounts (optional — enables Google sign-in + per-user key vault)
# Supabase project (free, choose region ap-south-1 / Mumbai for India)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Any OpenAI-compatible endpoint (vLLM, LM Studio, Together, DeepInfra…)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Rate limit: requests per minute per IP for /api/rk/chat
RK_RATE_LIMIT=30

# Public URL, only used for the OpenRouter HTTP-Referer header
RK_PUBLIC_URL=

# ── Google / Gemini ──────────────────────────────────────────────────
# Two ways for users to get Gemini power:
#  1. Free AI Studio key  → https://aistudio.google.com/app/apikey
#  2. Their existing Google Cloud project (billing/credits) → the
#     "Apna Google account jodein" panel in /settings detects which of
#     their projects already has the Generative Language API enabled.
# Enable Google sign-in: Supabase Dashboard → Authentication → Providers →
# Google, redirect URI = https://<ref>.supabase.co/auth/v1/callback
